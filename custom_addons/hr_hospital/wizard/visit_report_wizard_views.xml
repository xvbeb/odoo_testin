<odoo>
    <record id="visit_report_wizard_view_form" model="ir.ui.view">
        <field name="name">visit_report_wizard_form</field>
        <field name="model">visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Звіт по візитах">
                <group>
                    <group>
                        <field name="doctor_ids" widget="many2many_tags"/>
                        <field name="patient_ids" widget="many2many_tags"/>
                        <field name="disease_id"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="only_completed"/>
                    </group>
                </group>
                <footer>
                    <button name="action_show_visits" type="object" string="Показати візити"
                            class="btn-primary"/>
                    <button string="Скасувати" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="visit_report_wizard_action_doctor" model="ir.actions.act_window">
        <field name="name">Сформувати звіт по візитах</field>
        <field name="res_model">visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hospital_doctor"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="visit_report_wizard_action_patient" model="ir.actions.act_window">
        <field name="name">Сформувати звіт по візитах</field>
        <field name="res_model">visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hospital_patient"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
