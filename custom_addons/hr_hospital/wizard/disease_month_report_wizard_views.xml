<odoo>
    <record id="disease_month_report_wizard_view_form" model="ir.ui.view">
        <field name="name">disease_month_report_wizard_form</field>
        <field name="model">disease.month.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Звіт по захворюваннях за період">
                <group>
                    <field name="doctor_ids" widget="many2many_tags"
                           placeholder="Усі лікарі"/>
                    <field name="disease_ids" widget="many2many_tags"
                           placeholder="Усі захворювання"/>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_show_report" type="object"
                            string="Сформувати звіт" class="btn-primary"/>
                    <button string="Скасувати" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="disease_month_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Звіт по захворюваннях</field>
        <field name="res_model">disease.month.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hospital_doctor"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
