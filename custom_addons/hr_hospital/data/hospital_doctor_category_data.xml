<odoo noupdate="1">
    <!-- Основні кваліфікації лікарів. -->
    <record id="doctor_category_intern" model="hospital.doctor.category">
        <field name="name">Лікар-інтерн</field>
        <field name="sequence">10</field>
    </record>
    <record id="doctor_category_specialist" model="hospital.doctor.category">
        <field name="name">Лікар-спеціаліст</field>
        <field name="sequence">20</field>
    </record>
    <record id="doctor_category_highest" model="hospital.doctor.category">
        <field name="name">Лікар вищої категорії</field>
        <field name="sequence">30</field>
    </record>
</odoo>
