<odoo>
    <record id="hospital_patient_view_search" model="ir.ui.view">
        <field name="name">hospital_patient_search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Пошук пацієнтів">
                <field name="name" string="ПІБ або телефон"
                       filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="phone" string="Телефон"/>
                <field name="personal_doctor_id" string="Персональний лікар"/>
            </search>
        </field>
    </record>

    <record id="hospital_patient_view_list" model="ir.ui.view">
        <field name="name">hospital_patient_list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="phone"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="personal_doctor_id"/>
                <field name="insurance_policy" optional="show"/>
                <field name="disease_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hospital_patient_view_form" model="ir.ui.view">
        <field name="name">hospital_patient_form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Пацієнт">
                <header>
                    <button name="action_create_visit" type="object"
                            string="Створити візит" class="btn-primary"
                            invisible="not id or not personal_doctor_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_visits" type="object"
                                class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="visit_count" widget="statinfo" string="Історія візитів"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"
                                   groups="hr_hospital.group_hospital_administrator"/>
                            <field name="personal_doctor_id" domain="[('is_intern', '=', False)]"/>
                            <field name="insurance_policy"/>
                            <field name="disease_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="blood_group"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Історія лікарів">
                            <field name="doctor_history_ids">
                                <list editable="bottom">
                                    <field name="doctor_id"/>
                                    <field name="assignment_date"/>
                                    <field name="change_date"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Візити">
                            <field name="visit_ids" readonly="1"/>
                        </page>
                        <page string="Нотатки"><field name="notes"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_patient_action" model="ir.actions.act_window">
        <field name="name">Пацієнти</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hospital_patient_view_search"/>
    </record>
</odoo>
