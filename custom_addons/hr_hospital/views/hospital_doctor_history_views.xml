<odoo>
    <record id="hospital_doctor_history_view_list" model="ir.ui.view">
        <field name="name">hospital_doctor_history_list</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="assignment_date"/>
                <field name="change_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="hospital_doctor_history_view_form" model="ir.ui.view">
        <field name="name">hospital_doctor_history_form</field>
        <field name="model">hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="assignment_date"/>
                            <field name="change_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_doctor_history_action" model="ir.actions.act_window">
        <field name="name">Історія персональних лікарів</field>
        <field name="res_model">hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
