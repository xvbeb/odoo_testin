<odoo>
    <record id="hospital_doctor_category_view_list" model="ir.ui.view">
        <field name="name">hospital_doctor_category_list</field>
        <field name="model">hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="doctor_ids" widget="many2many_tags" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="hospital_doctor_category_view_form" model="ir.ui.view">
        <field name="name">hospital_doctor_category_form</field>
        <field name="model">hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                    <field name="doctor_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="specialization"/>
                            <field name="is_intern"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_doctor_category_action" model="ir.actions.act_window">
        <field name="name">Кваліфікації лікарів</field>
        <field name="res_model">hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
