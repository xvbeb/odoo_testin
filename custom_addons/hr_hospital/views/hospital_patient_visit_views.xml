<odoo>
    <record id="hospital_patient_visit_view_list" model="ir.ui.view">
        <field name="name">hospital.patient.visit.list</field>
        <field name="model">hospital.patient.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="visit_datetime"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
            </list>
        </field>
    </record>
    <record id="hospital_patient_visit_view_form" model="ir.ui.view">
        <field name="name">hospital.patient.visit.form</field>
        <field name="model">hospital.patient.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="visit_datetime"/>
                            <field name="disease_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="diagnosis"/>
                        <field name="recommendations"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_patient_visit_action" model="ir.actions.act_window">
        <field name="name">Patient Visits</field>
        <field name="res_model">hospital.patient.visit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
