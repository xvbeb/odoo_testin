<odoo>
    <record id="hospital_disease_view_list" model="ir.ui.view">
        <field name="name">hospital_disease_list</field>
        <field name="model">hospital.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="description" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="hospital_disease_view_form" model="ir.ui.view">
        <field name="name">hospital_disease_form</field>
        <field name="model">hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Дочірні хвороби">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hospital_disease_action" model="ir.actions.act_window">
        <field name="name">Хвороби</field>
        <field name="res_model">hospital.disease</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
