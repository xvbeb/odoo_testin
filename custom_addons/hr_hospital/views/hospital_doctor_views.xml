<odoo>
    <record id="hospital_doctor_view_search" model="ir.ui.view">
        <field name="name">hospital_doctor_search</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Пошук лікарів">
                <field name="name" string="ПІБ"/>
                <field name="specialization" string="Спеціалізація"/>
                <field name="category_id" string="Категорія"/>
                <filter name="mentors" string="Ментори" domain="[('intern_ids', '!=', False)]"/>
                <filter name="interns" string="Інтерни" domain="[('is_intern', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="hospital_doctor_view_list" model="ir.ui.view">
        <field name="name">hospital_doctor_list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list decoration-info="is_intern" decoration-muted="not active">
                <field name="name"/>
                <field name="category_id"/>
                <field name="specialization"/>
                <field name="is_intern"/>
                <field name="mentor_id" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="phone" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hospital_doctor_view_kanban" model="ir.ui.view">
        <field name="name">hospital_doctor_kanban</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="specialization"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
                <field name="phone"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong class="fs-5"><field name="name"/></strong>
                            <span t-if="record.is_intern.raw_value"
                                  class="badge text-bg-info">Інтерн</span>
                        </div>
                        <div class="text-muted mb-1"><field name="specialization"/></div>
                        <div t-if="record.mentor_id.raw_value" class="mb-1">
                            Ментор: <field name="mentor_id"/>
                        </div>
                        <div class="mb-3"><field name="phone"/></div>
                        <button name="action_schedule_visit" type="object"
                                string="Записати на прийом"
                                class="btn btn-primary btn-sm"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hospital_doctor_view_form" model="ir.ui.view">
        <field name="name">hospital_doctor_form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Лікар">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialization"/>
                            <field name="category_id"/>
                            <field name="is_intern" readonly="1"/>
                            <field name="mentor_id" string="Ментор"
                                   invisible="not is_intern" required="is_intern"
                                   domain="[('is_intern', '=', False), ('id', '!=', id)]"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                            <field name="blood_group"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Відомості про ментора" invisible="not mentor_id">
                            <group>
                                <field name="mentor_id" readonly="1"/>
                                <field name="mentor_specialization" readonly="1"/>
                                <field name="mentor_category_id" readonly="1"/>
                                <field name="mentor_phone" readonly="1"/>
                                <field name="mentor_email" readonly="1"/>
                            </group>
                        </page>
                        <page string="Інтерни" invisible="not intern_ids">
                            <field name="intern_ids" readonly="1" mode="kanban">
                                <kanban>
                                    <field name="name"/>
                                    <field name="specialization"/>
                                    <field name="category_id"/>
                                    <field name="phone"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="fw-bold"><field name="name"/></div>
                                            <div><field name="specialization"/></div>
                                            <div><field name="category_id"/></div>
                                            <div><field name="phone"/></div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Пацієнти"><field name="patient_ids" readonly="1"/></page>
                        <page string="Візити"><field name="visit_ids" readonly="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_doctor_action" model="ir.actions.act_window">
        <field name="name">Лікарі</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="hospital_doctor_view_search"/>
        <field name="context">{'group_by': 'category_id'}</field>
    </record>
</odoo>
